{
  "manifest_version": 3,
  "name": "MISO Consigliere",
  "version": "1.0",
  "description": "Real-time AI counsel during Google Meet. Type @miso: in chat to trigger actions.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://miso.stemcultivation.com/*"
  ],
  "content_scripts": [{
    "matches": ["https://meet.google.com/*"],
    "js": ["content.js"],
    "css": ["sidebar.css"],
    "run_at": "document_idle"
  }]
}
