FROM python:3.10-slim

WORKDIR /app

# System dependencies
RUN apt-get update && apt-get install -y gcc libpq-dev && rm -rf /var/lib/apt/lists/*

# Python dependencies (Added 'databases')
RUN pip install --no-cache-dir fastapi uvicorn[standard] httpx asyncpg pydantic python-dotenv requests databases

# Copy code
COPY . .

# Launch
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
